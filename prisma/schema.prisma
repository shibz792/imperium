// Imperium Realty OS — Prisma schema
// Postgres (Supabase), via the pg driver adapter. Was SQLite for local-first
// zero-config running, moved to Postgres so writes actually persist on
// Vercel's serverless runtime instead of vanishing on the next cold start.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  DIRECTOR
  SALES_MANAGER
  AGENT
  MARKETING
  LEGAL
  FINANCE
  EXTERNAL_BROKER
  OWNER_PORTAL
  CLIENT_PORTAL
}

model User {
  id                      String             @id @default(cuid())
  name                    String
  email                   String             @unique
  username                String             @unique
  passwordHash            String
  role                    Role
  phone                   String?
  active                  Boolean            @default(true)
  // Agent profile — spec §11/§14 "Agents" roster (title/specialty shown on
  // the public-facing profile card, territory used for demand-matching).
  title                   String?
  bio                     String?
  territoryJson           Json?
  // The notification bell's badge only counts tasks/offers that showed up
  // after this — opening the bell moves it forward, same as any "mark all
  // read" pattern, without needing a separate read-state row per item.
  lastNotificationsSeenAt DateTime?
  // This agent's default commission terms — used whenever a deal they're
  // assigned to auto-drafts a Commission on Closed Won. PERCENT is a % of
  // the agency fee; FIXED is a flat LKR amount per deal. Null rate falls
  // back to the company default split (50%). A specific deal's commission
  // can still be adjusted afterward without touching this default.
  commissionRateType      CommissionRateType @default(PERCENT)
  commissionRate          Float?
  createdAt               DateTime           @default(now())

  assignedProperties        Property[]              @relation("PropertyAgent")
  assignedContacts          Contact[]
  assignedRequirements      Requirement[]           @relation("RequirementAgent")
  assignedDeals             Deal[]                  @relation("DealAgent")
  // Multiple agents can work the same listing/requirement/deal together —
  // "assigned" is the primary owner, "collaborating" is everyone else on it.
  collaboratingProperties   Property[]              @relation("PropertyCollaborators")
  collaboratingRequirements Requirement[]           @relation("RequirementCollaborators")
  collaboratingDeals        Deal[]                  @relation("DealCollaborators")
  viewingsAsAgent           Viewing[]               @relation("ViewingAgent")
  tasks                     Task[]                  @relation("TaskAssignee")
  tasksCreated              Task[]                  @relation("TaskCreator")
  auditLogs                 AuditLog[]
  activities                Activity[]
  aiIntakeJobs              AiIntakeJob[]
  documentsUploaded         Document[]
  marketingApproved         MarketingAsset[]        @relation("MarketingApprover")
  notes                     Note[]
  googleAccount             GoogleAccount?
  metaAccountsConnected     MetaAccount[]           @relation("MetaConnector")
  metaPostsPublished        MetaPublishedPost[]     @relation("MetaPublisher")
  metaCampaignsCreated      MetaCampaign[]          @relation("MetaCampaignCreator")
  excludedFromContacts      ContactAgentExclusion[] @relation("ExcludedFromContact")
  contactExclusionsCreated  ContactAgentExclusion[] @relation("ContactExclusionCreator")
}

// One connected Google account per user — Calendar (two-way: viewings/tasks
// push out as events, freebusy checked before double-booking an agent) and
// Drive (browse + import existing files into a property's media/documents).
// Tokens are server-side only, never sent to the browser. refreshToken is
// only returned by Google on the very first consent (access_type=offline,
// prompt=consent) — the connect flow forces that every time so reconnecting
// after a revoke still gets one.
model GoogleAccount {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email            String
  accessToken      String
  refreshToken     String
  expiresAt        DateTime
  scope            String
  // The one connected account (of possibly several — everyone can connect
  // their own for Calendar) designated as the company's shared Drive for
  // property media. Admin-only to change; at most one true at a time,
  // enforced in the designateStorageAccount action rather than the schema.
  // Uploads/imports/views use this account's Drive regardless of who's
  // logged into the CRM at the time.
  isStorageAccount Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Contacts / CRM
// ---------------------------------------------------------------------------

enum ContactType {
  OWNER
  BUYER
  TENANT
  BROKER
  DEVELOPER
  INVESTOR
  CORPORATE
  // A listing poster picked up via External Sourcing (ikman.lk /
  // LankaPropertyWeb) — deliberately its own type, not folded into BROKER:
  // we don't yet know if they're the owner, an informal middleman, or a
  // real co-broking partner, just that we found them on a public listing
  // and want to keep a record without pretending to know more than we do.
  OUTSOURCED
}

// Kept deliberately thin: Sri Lankan lead intake in practice is "name,
// number, and are they the owner / a company / someone representing them"
// — not a full legal-contact record. Everything past that (email, address,
// company name, notes) is optional and tucked behind "more details" in
// the UI rather than demanded up front.
enum ContactCapacity {
  INDIVIDUAL
  COMPANY
  REPRESENTATIVE
}

model Contact {
  id                String          @id @default(cuid())
  contactRef        String          @unique
  name              String
  capacity          ContactCapacity @default(INDIVIDUAL)
  companyName       String?
  contactType       ContactType
  phone             String
  whatsapp          String?
  email             String?
  address           String?
  city              String?
  district          String?
  source            String?
  notes             String?
  confidentialNotes String?
  assignedAgentId   String?
  assignedAgent     User?           @relation(fields: [assignedAgentId], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  ownedProperties Property[]              @relation("PropertyOwner")
  requirements    Requirement[]           @relation("RequirementClient")
  dealsAsClient   Deal[]                  @relation("DealClient")
  dealsAsBroker   Deal[]                  @relation("DealOtherBroker")
  viewings        Viewing[]               @relation("ViewingContact")
  documents       Document[]
  activities      Activity[]
  agentExclusions ContactAgentExclusion[]

  @@index([contactType])
  @@index([assignedAgentId])
  @@index([district])
}

// "This contact has told us they won't work with agent X" — a real,
// specific fact worth recording (a past dispute, a personal conflict),
// not something to silently drop. Enforced at the point an agent would
// actually be assigned to this contact (updateContact / bulk reassign),
// and surfaced as a warning to the excluded agent themselves wherever
// they view the contact.
model ContactAgentExclusion {
  id          String   @id @default(cuid())
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  agentId     String
  agent       User     @relation("ExcludedFromContact", fields: [agentId], references: [id], onDelete: Cascade)
  reason      String?
  createdById String?
  createdBy   User?    @relation("ContactExclusionCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([contactId, agentId])
  @@index([agentId])
}

// ---------------------------------------------------------------------------
// Properties
// ---------------------------------------------------------------------------

enum PropertyCategory {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL_LOGISTICS
  LAND_AGRICULTURE
}

// The agency fee % a deal defaults to when no one's typed a specific one in
// — a warehouse deal and a house sale don't necessarily earn the same rate.
// One row per category, admin-editable (Admin → Categories); a missing row
// falls back to a flat 2.5% (see computeAgencyFeePct in lib/commission.ts).
model CommissionRateRule {
  id           String           @id @default(cuid())
  category     PropertyCategory @unique
  agencyFeePct Float
  updatedAt    DateTime         @updatedAt
}

enum TransactionType {
  SALE
  RENT
  LEASE
  SHORT_TERM_RENTAL
  INVESTMENT
  JOINT_VENTURE
  DEVELOPMENT
  OFF_MARKET
}

enum ListingStatus {
  DRAFT
  ACTIVE
  UNDER_OFFER
  RESERVED
  SOLD
  RENTED
  WITHDRAWN
  EXPIRED
}

enum Exclusivity {
  EXCLUSIVE
  OPEN
}

enum MarkupType {
  NONE
  PERCENT
  FIXED
}

enum LocationVisibility {
  EXACT
  APPROXIMATE
  HIDDEN
}

enum LegalVerificationStatus {
  UNVERIFIED
  IN_PROGRESS
  VERIFIED
  ISSUES_FOUND
}

model Property {
  id                 String  @id @default(cuid())
  propertyRef        String  @unique
  title              String
  description        String?
  // Cached so media uploads don't re-search Drive for "does this property's
  // folder already exist" on every file — set the first time this property
  // gets a photo, in the company Drive's Property Media root folder.
  driveMediaFolderId String?

  category        PropertyCategory
  subtype         String
  transactionType TransactionType
  listingStatus   ListingStatus    @default(DRAFT)
  exclusivity     Exclusivity      @default(OPEN)
  source          String?
  sourceUrl       String? // original listing link when sourced from ikman.lk / LankaPropertyWeb / etc.

  assignedAgentId  String?
  assignedAgent    User?     @relation("PropertyAgent", fields: [assignedAgentId], references: [id])
  dateReceived     DateTime  @default(now())
  lastVerifiedDate DateTime?
  expiryDate       DateTime?

  // Location
  province            String?
  district            String?
  city                String?
  suburb              String?
  address             String?
  landmark            String?
  lat                 Float?
  lng                 Float?
  locationVisibility  LocationVisibility @default(APPROXIMATE)
  roadAccess          String?
  roadWidthFt         Float?
  distanceMajorRoadKm Float?

  // Measurements
  sizePerches        Float?
  sizeAcres          Float?
  sizeRoods          Float?
  sizeSqft           Float?
  sizeSqm            Float?
  builtUpSqft        Float?
  warehouseFloorSqft Float?
  frontageFt         Float?
  buildingHeightFt   Float?
  clearHeightFt      Float?
  floors             Int?
  bedrooms           Int?
  bathrooms          Int?

  // Pricing. totalPrice/monthlyRental/annualLeaseValue is what the client
  // actually asked for. Some listings the client authorizes a markup on —
  // advertisedPrice (client price + markup) is what buyers actually see
  // everywhere: property cards, WhatsApp messages, matching. Client price
  // and markup are confidential-gated on the detail page, same as
  // ownerMinPrice — the spread is commercially sensitive.
  totalPrice         Float?
  priceNegotiable    Boolean    @default(false)
  pricePerPerch      Float?
  pricePerSqft       Float?
  monthlyRental      Float?
  annualLeaseValue   Float?
  keyMoney           Float?
  securityDeposit    Float?
  minLeaseTermMonths Int?
  expectedYieldPct   Float?
  currency           String     @default("LKR")
  ownerMinPrice      Float?
  markupType         MarkupType @default(NONE)
  markupValue        Float?
  advertisedPrice    Float?

  featuresJson Json?

  // Ownership & documents
  ownerId                 String?
  owner                   Contact?                @relation("PropertyOwner", fields: [ownerId], references: [id])
  ownerAuthorityConfirmed Boolean                 @default(false)
  deedAvailable           Boolean                 @default(false)
  surveyPlanAvailable     Boolean                 @default(false)
  cocAvailable            Boolean                 @default(false)
  approvedPlanAvailable   Boolean                 @default(false)
  municipalDocsAvailable  Boolean                 @default(false)
  taxDocsAvailable        Boolean                 @default(false)
  mortgageStatus          String?
  legalVerificationStatus LegalVerificationStatus @default(UNVERIFIED)
  internalLegalNotes      String?

  heroImageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collaborators   User[]           @relation("PropertyCollaborators")
  media           PropertyMedia[]
  documents       Document[]
  viewings        Viewing[]
  deals           Deal[]
  marketingAssets MarketingAsset[]
  sharePages      SharePage[]
  activities      Activity[]
  matchShares     MatchShare[]
  notes           Note[]
  metaCampaigns   MetaCampaign[]

  @@index([listingStatus])
  @@index([assignedAgentId])
  @@index([ownerId])
  @@index([district])
  @@index([city])
  @@index([category])
  @@index([createdAt])
}

enum MediaType {
  PHOTO
  VIDEO
  DRONE
  FLOOR_PLAN
  SITE_PLAN
  TOUR_360
}

model PropertyMedia {
  id          String    @id @default(cuid())
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  // Servable URL — our own /api/drive-media/[fileId] proxy, not a direct
  // Drive link, so it works whether or not the file's public-permission
  // survives a manual edit in Drive itself. driveFileId is the real
  // identity; url is derived from it at upload time and kept for
  // convenience (every render site already just reads .url as an <img> src).
  url         String
  driveFileId String?
  type        MediaType
  branded     Boolean   @default(false)
  caption     String?
  // The one photo shown on cards and list rows — at most one true per
  // property, enforced in the setCoverPhoto action (unset the rest, then
  // set this one) rather than in the schema.
  isCover     Boolean   @default(false)
  // Manual gallery position, independent of isCover — the cover photo
  // always renders first regardless of its own `order` value (see the
  // orderBy in every query against this model: isCover desc, order asc),
  // this only controls the arrangement of the rest. New uploads append at
  // the end (max(order)+1); reorderPropertyMedia rewrites these in bulk.
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([propertyId])
}

// ---------------------------------------------------------------------------
// Requirements
// ---------------------------------------------------------------------------

enum RequirementType {
  BUYER
  TENANT
  CORPORATE_LEASE
  INVESTOR_MANDATE
  DEVELOPER_LAND
  WAREHOUSE
  HOSPITALITY
  RELOCATION
  SELLER_VALUATION
  OWNER_SEEKING_TENANT
}

enum DealType {
  BUY
  RENT
  LEASE
}

enum FinancingStatus {
  CASH
  BANK_FINANCE
  UNCONFIRMED
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RequirementQuality {
  UNVERIFIED
  QUALIFIED
  PREMIUM
}

enum RequirementStatus {
  NEW
  UNVERIFIED
  QUALIFIED
  ACTIVELY_SEARCHING
  OPTIONS_SHARED
  VIEWING_ARRANGED
  NEGOTIATING
  ON_HOLD
  COMPLETED
  LOST_EXPIRED
}

model Requirement {
  id             String          @id @default(cuid())
  requirementRef String          @unique
  type           RequirementType
  clientId       String
  client         Contact         @relation("RequirementClient", fields: [clientId], references: [id])
  companyName    String?
  decisionMaker  String?
  title          String

  dealType DealType
  category PropertyCategory
  subtype  String?

  preferredLocationsJson    Json?
  acceptableSurroundingJson Json?

  budgetMin Float?
  budgetMax Float?
  sizeMin   Float?
  sizeMax   Float?

  requiredFeaturesJson Json?
  intendedUse          String?
  deadline             DateTime?

  financingStatus FinancingStatus    @default(UNCONFIRMED)
  decisionStage   String?
  urgency         Urgency            @default(MEDIUM)
  quality         RequirementQuality @default(UNVERIFIED)

  assignedAgentId String?
  assignedAgent   User?     @relation("RequirementAgent", fields: [assignedAgentId], references: [id])
  source          String?
  lastContacted   DateTime?
  nextAction      String?
  nextActionDate  DateTime?

  confidentialNotes String?
  expiryDate        DateTime?
  status            RequirementStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collaborators User[]       @relation("RequirementCollaborators")
  deals         Deal[]
  activities    Activity[]
  matchShares   MatchShare[]

  @@index([status])
  @@index([clientId])
  @@index([assignedAgentId])
  @@index([dealType])
  @@index([category])
}

// ---------------------------------------------------------------------------
// Deals pipeline
// ---------------------------------------------------------------------------

enum DealStage {
  NEW_INQUIRY
  CONTACT_ATTEMPTED
  QUALIFIED
  SHORTLISTED
  VIEWING_ARRANGED
  VIEWING_COMPLETED
  NEGOTIATION
  OFFER_SUBMITTED
  AGREEMENT_PENDING
  CLOSED_WON
  CLOSED_LOST
}

model Deal {
  id      String @id @default(cuid())
  dealRef String @unique

  propertyId    String
  property      Property     @relation(fields: [propertyId], references: [id])
  requirementId String?
  requirement   Requirement? @relation(fields: [requirementId], references: [id])
  clientId      String
  client        Contact      @relation("DealClient", fields: [clientId], references: [id])

  assignedAgentId String?
  assignedAgent   User?    @relation("DealAgent", fields: [assignedAgentId], references: [id])
  otherBrokerId   String?
  otherBroker     Contact? @relation("DealOtherBroker", fields: [otherBrokerId], references: [id])

  stage                 DealStage @default(NEW_INQUIRY)
  expectedValue         Float?
  expectedCommissionPct Float?
  probability           Int       @default(20)
  nextAction            String?
  nextActionDate        DateTime?
  closingDate           DateTime?
  lostReason            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collaborators User[]      @relation("DealCollaborators")
  viewings      Viewing[]
  offers        Offer[]
  commission    Commission?
  activities    Activity[]

  @@index([stage])
  @@index([propertyId])
  @@index([clientId])
  @@index([requirementId])
  @@index([assignedAgentId])
  @@index([otherBrokerId])
}

enum ViewingStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Viewing {
  id             String        @id @default(cuid())
  propertyId     String
  property       Property      @relation(fields: [propertyId], references: [id])
  dealId         String?
  deal           Deal?         @relation(fields: [dealId], references: [id])
  contactId      String
  contact        Contact       @relation("ViewingContact", fields: [contactId], references: [id])
  agentId        String?
  agent          User?         @relation("ViewingAgent", fields: [agentId], references: [id])
  scheduledAt    DateTime
  status         ViewingStatus @default(SCHEDULED)
  feedbackRating Int?
  feedbackNotes  String?
  // Set once this viewing is pushed to the agent's Google Calendar — lets
  // later edits update the same event instead of creating a duplicate.
  googleEventId  String?
  createdAt      DateTime      @default(now())

  @@index([propertyId])
  @@index([contactId])
  @@index([dealId])
  @@index([agentId])
  @@index([scheduledAt])
}

enum OfferStatus {
  SUBMITTED
  COUNTERED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model Offer {
  id          String      @id @default(cuid())
  dealId      String
  deal        Deal        @relation(fields: [dealId], references: [id])
  amount      Float
  terms       String?
  submittedBy String?
  status      OfferStatus @default(SUBMITTED)
  createdAt   DateTime    @default(now())
  respondedAt DateTime?

  @@index([dealId])
}

enum CommissionStatus {
  PENDING
  INVOICED
  PARTIALLY_PAID
  PAID
  OVERDUE
}

model Commission {
  id                String              @id @default(cuid())
  dealId            String              @unique
  deal              Deal                @relation(fields: [dealId], references: [id])
  agencyFeePct      Float?
  agencyFeeAmount   Float?
  // How agentSplitAmount below was actually derived for this deal — kept
  // alongside the amount even if the agent's own default rate changes
  // later, so a paid-out commission's record doesn't silently reinterpret
  // itself. agentSplitPct is null when the split was a flat FIXED amount.
  agentSplitType    CommissionRateType?
  agentSplitPct     Float?
  agentSplitAmount  Float?
  brokerSplitPct    Float?
  brokerSplitAmount Float?
  status            CommissionStatus    @default(PENDING)
  dueDate           DateTime?
  paidDate          DateTime?
  notes             String?
  createdAt         DateTime            @default(now())
}

// PERCENT: agentSplitAmount = agencyFeeAmount × rate/100 (the common case).
// FIXED: agentSplitAmount = rate itself, a flat LKR amount regardless of
// deal size (capped at the agency fee so the company split can't go
// negative) — some senior agents are paid this way instead of a cut.
enum CommissionRateType {
  PERCENT
  FIXED
}

// ---------------------------------------------------------------------------
// Documents, marketing, sharing
// ---------------------------------------------------------------------------

enum DocumentCategory {
  DEED
  SURVEY_PLAN
  COC
  APPROVED_PLAN
  MUNICIPAL
  TAX
  AGREEMENT
  IDENTIFICATION
  OTHER
}

model Document {
  id           String           @id @default(cuid())
  propertyId   String?
  property     Property?        @relation(fields: [propertyId], references: [id])
  contactId    String?
  contact      Contact?         @relation(fields: [contactId], references: [id])
  name         String
  category     DocumentCategory
  fileUrl      String
  confidential Boolean          @default(true)
  expiresAt    DateTime?
  uploadedById String?
  uploadedBy   User?            @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime         @default(now())

  @@index([propertyId])
  @@index([contactId])
  @@index([uploadedById])
}

enum MarketingContentType {
  DESCRIPTION
  WHATSAPP
  META_AD
  FB_MARKETPLACE
  INSTAGRAM_CAPTION
  WEBSITE_COPY
  EMAIL_CAMPAIGN
  BROCHURE
  SOCIAL_1_1
  STORY_9_16
  // Organic Facebook Page post — distinct tone from META_AD (which is
  // written to survive truncation and always carries a hard CTA) and from
  // FB_MARKETPLACE (price/spec-first, no brand voice). Published directly
  // to the connected Page via lib/meta.ts.
  FB_PAGE_POST
}

enum Language {
  EN
  SI
  TA
}

model MarketingAsset {
  id            String               @id @default(cuid())
  propertyId    String
  property      Property             @relation(fields: [propertyId], references: [id])
  contentType   MarketingContentType
  language      Language             @default(EN)
  content       String
  approved      Boolean              @default(false)
  approvedById  String?
  approvedBy    User?                @relation("MarketingApprover", fields: [approvedById], references: [id])
  createdAt     DateTime             @default(now())
  // AI-composed social tile — only ever set for SOCIAL_1_1 / STORY_9_16
  // rows. Stored directly in Postgres (not Google Drive) so image
  // generation works standalone on this platform regardless of whether a
  // Drive storage account is connected — the property photo it's
  // composited from may still come from Drive, but the *output* has no
  // external dependency. Served through /api/marketing-image/[id].
  imageData     Bytes?
  imageMimeType String?
  imageUrl      String?

  publishedPosts MetaPublishedPost[]
  metaCampaigns  MetaCampaign[]

  @@index([propertyId])
  @@index([approvedById])
}

enum ShareVisibility {
  PUBLIC
  UNLISTED
  PASSWORD
  EXPIRING
}

model SharePage {
  id                  String          @id @default(cuid())
  propertyId          String
  property            Property        @relation(fields: [propertyId], references: [id])
  slug                String          @unique
  visibility          ShareVisibility @default(UNLISTED)
  password            String?
  expiresAt           DateTime?
  watermarkClientName String?
  hideOwnerContact    Boolean         @default(true)
  hideExactLocation   Boolean         @default(true)
  viewCount           Int             @default(0)
  createdAt           DateTime        @default(now())

  @@index([propertyId])
}

// ---------------------------------------------------------------------------
// Meta (Facebook/Instagram) connection — one shared, company-wide connection
// (not per-user, unlike GoogleAccount): Marketing Studio publishing/ads are
// a shared team function, so whoever connects becomes "the connection",
// closer to GoogleAccount.isStorageAccount's single admin-designated shared
// resource than to Calendar's personal per-user account. Fully dormant
// until META_APP_ID/SECRET/REDIRECT_URI are set — same two-tier shape as
// Google OAuth and WhatsApp Cloud API elsewhere in this app.
// ---------------------------------------------------------------------------

model MetaAccount {
  id                String   @id @default(cuid())
  connectedByUserId String
  connectedBy       User     @relation("MetaConnector", fields: [connectedByUserId], references: [id])
  metaUserId        String // Facebook user id the token belongs to
  metaUserName      String?
  // Long-lived user access token (~60 days). Facebook has no refresh_token
  // grant like Google — long-lived tokens are extended by re-exchanging the
  // current one via fb_exchange_token before expiry, not a separate stored
  // refresh credential.
  accessToken       String
  expiresAt         DateTime
  scope             String // raw comma-joined scope string Meta granted
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  pages      MetaPage[]
  adAccounts MetaAdAccount[]
}

// A Page the connected account manages. 1:many — a real agency's Facebook
// user commonly manages several Pages — but only one is ever "active",
// mirroring GoogleAccount.isStorageAccount's single-shared-designation
// pattern rather than a picker shown on every publish action.
model MetaPage {
  id                  String      @id @default(cuid())
  metaAccountId       String
  metaAccount         MetaAccount @relation(fields: [metaAccountId], references: [id], onDelete: Cascade)
  pageId              String      @unique // Facebook Page id
  name                String
  // Page Access Token — separate from, and outliving, the user token that
  // fetched it (tokens derived from a long-lived user token are themselves
  // long-lived/non-expiring in practice).
  pageAccessToken     String
  category            String?
  igBusinessAccountId String? // Instagram Business Account id linked to this Page, if any
  igUsername          String?
  isActive            Boolean     @default(false) // the one Page the whole team publishes to
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  publishedPosts MetaPublishedPost[]

  @@index([metaAccountId])
}

// An ad account the connected account can spend from. Kept separate from
// MetaPage (a Page can exist with no ad account; one Business Portfolio
// commonly funds ads promoting several Pages) — single "isActive"
// designation for the same one-shared-choice reason as Pages.
model MetaAdAccount {
  id            String      @id @default(cuid())
  metaAccountId String
  metaAccount   MetaAccount @relation(fields: [metaAccountId], references: [id], onDelete: Cascade)
  adAccountId   String      @unique // "act_<id>" form Meta returns
  name          String
  currency      String
  accountStatus Int // Meta's numeric status (1 = active)
  isActive      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  campaigns MetaCampaign[]

  @@index([metaAccountId])
}

enum MetaPublishTarget {
  FACEBOOK_PAGE
  INSTAGRAM
}

enum MetaPublishStatus {
  PUBLISHED
  FAILED
}

// One row per publish attempt, not columns on MarketingAsset — a single
// approved asset is routinely posted to Facebook AND Instagram, and
// re-published after edits, so this is 1:many from the start. Also the
// natural place to hang the "View on Facebook/Instagram" permalink once
// Meta returns one.
model MetaPublishedPost {
  id               String            @id @default(cuid())
  marketingAssetId String
  marketingAsset   MarketingAsset    @relation(fields: [marketingAssetId], references: [id])
  target           MetaPublishTarget
  metaPageId       String?
  metaPage         MetaPage?         @relation(fields: [metaPageId], references: [id])
  externalPostId   String? // Page post id, or IG media id after publish
  permalinkUrl     String? // resolved via GET /{post-id}?fields=permalink_url
  status           MetaPublishStatus
  errorMessage     String?
  publishedById    String
  publishedBy      User              @relation("MetaPublisher", fields: [publishedById], references: [id])
  createdAt        DateTime          @default(now())

  @@index([marketingAssetId])
  @@index([metaPageId])
}

enum MetaAdObjective {
  OUTCOME_TRAFFIC
  OUTCOME_LEADS
  OUTCOME_ENGAGEMENT
}

enum MetaCampaignStatus {
  ACTIVE
  PAUSED
  DELETED
  ARCHIVED
  ERROR // synthetic status: created but never confirmed live
}

// One row per "Boost this listing" click. Deliberately flat — campaign, ad
// set, ad, and creative ids all live on one row instead of four normalized
// tables, since this flow only ever creates exactly one of each per boost
// (no ad-set-level audience splitting, no multiple ads per campaign). A real
// Ads Manager needs the full hierarchy; this focused flow doesn't.
model MetaCampaign {
  id               String          @id @default(cuid())
  propertyId       String
  property         Property        @relation(fields: [propertyId], references: [id])
  marketingAssetId String? // the creative (image + copy) this ad used
  marketingAsset   MarketingAsset? @relation(fields: [marketingAssetId], references: [id])
  adAccountId      String
  adAccount        MetaAdAccount   @relation(fields: [adAccountId], references: [id])

  externalCampaignId String // Meta's campaign id
  externalAdSetId    String
  externalAdId       String
  externalCreativeId String

  objective         MetaAdObjective
  dailyBudgetCents  Int // minor units, account currency
  startDate         DateTime
  endDate           DateTime?
  targetingLocation String // human-readable summary (e.g. "Colombo, Sri Lanka") for display
  targetingGeoJson  Json // raw Targeting Search API result actually sent to Meta

  status      MetaCampaignStatus @default(ACTIVE)
  createdById String
  createdBy   User               @relation("MetaCampaignCreator", fields: [createdById], references: [id])
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  insights MetaCampaignInsight[]

  @@index([propertyId])
  @@index([adAccountId])
}

// Point-in-time snapshot, not upserted in place — keeps real spend-over-time
// history instead of only ever knowing the latest number, and makes "last
// synced" trivially the most recent row's syncedAt.
model MetaCampaignInsight {
  id                 String       @id @default(cuid())
  campaignId         String
  campaign           MetaCampaign @relation(fields: [campaignId], references: [id])
  impressions        Int
  reach              Int
  clicks             Int
  spendCents         Int
  ctr                Float
  cpcCents           Int
  costPerResultCents Int?
  syncedAt           DateTime     @default(now())

  @@index([campaignId, syncedAt])
}

// ---------------------------------------------------------------------------
// AI Intake
// ---------------------------------------------------------------------------

enum IntakeMode {
  PROPERTY
  REQUIREMENT
  AUTO
  UPDATE
}

enum IntakeStatus {
  PENDING
  REVIEWED
}

model AiIntakeJob {
  id          String       @id @default(cuid())
  rawText     String
  mode        IntakeMode
  engine      String
  resultJson  Json
  status      IntakeStatus @default(PENDING)
  createdById String?
  createdBy   User?        @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())

  @@index([createdById])
}

// ---------------------------------------------------------------------------
// Matching, tasks, activity, audit
// ---------------------------------------------------------------------------

model MatchShare {
  id            String      @id @default(cuid())
  propertyId    String
  property      Property    @relation(fields: [propertyId], references: [id])
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id])
  score         Int
  sharedAt      DateTime    @default(now())
  channel       String?

  @@index([propertyId])
  @@index([requirementId])
}

enum TaskType {
  CONTACT_INQUIRY
  VIEWING_CONFIRM
  CLIENT_UPDATE
  LISTING_VERIFY
  OFFER_RESPONSE
  LEASE_EXPIRY
  COMMISSION_OVERDUE
  REQUIREMENT_RECONFIRM
  CUSTOM
}

enum TaskStatus {
  OPEN
  DONE
  SNOOZED
}

model Task {
  id                String     @id @default(cuid())
  type              TaskType
  title             String
  dueAt             DateTime
  // Same loose polymorphic pointer as Activity — "property" | "requirement"
  // | null (a general task with no linked record). CUSTOM-type tasks
  // created directly by a user, same spirit as Note.
  relatedEntityType String?
  relatedEntityId   String?
  assignedToId      String?
  assignedTo        User?      @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdById       String?
  createdBy         User?      @relation("TaskCreator", fields: [createdById], references: [id])
  status            TaskStatus @default(OPEN)
  googleEventId     String?
  createdAt         DateTime   @default(now())

  @@index([assignedToId])
  @@index([status])
  @@index([dueAt])
  @@index([relatedEntityType, relatedEntityId])
}

model Activity {
  id            String       @id @default(cuid())
  entityType    String
  propertyId    String?
  property      Property?    @relation(fields: [propertyId], references: [id])
  requirementId String?
  requirement   Requirement? @relation(fields: [requirementId], references: [id])
  dealId        String?
  deal          Deal?        @relation(fields: [dealId], references: [id])
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id])
  type          String
  message       String
  userId        String?
  user          User?        @relation(fields: [userId], references: [id])
  createdAt     DateTime     @default(now())

  @@index([propertyId])
  @@index([requirementId])
  @@index([dealId])
  @@index([contactId])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Notes — a plain scratchpad, optionally attached to a property. Deliberately
// unstructured (no categories, no rich text) so it's actually fast to jot
// something down, the same reasoning behind the thin Contact model.
// ---------------------------------------------------------------------------

model Note {
  id         String    @id @default(cuid())
  content    String
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?     @relation(fields: [authorId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([propertyId])
  @@index([authorId])
  @@index([createdAt])
}
